extends RefCounted
func run(t: TestAssert) -> void:
	var router: InputRouter = InputRouter.new()
	router.configure(GameTypes.SettingsData.new())
	var event: InputEventKey = InputEventKey.new()
	event.physical_keycode = KEY_W; event.pressed = true
	router.feed(event)
	t.equal(router.sample(1).axis(),Vector2.ZERO,"I01 menu neutral")
	router.set_enabled(true); router.feed(event)
	t.equal(router.sample(2).axis(),Vector2.UP,"I01 movement event")
	event.physical_keycode = KEY_SPACE; router.feed(event)
	t.equal(router.sample(3).dash_serial,1,"I01 dash rising edge")
	router.feed(event)
	t.equal(router.sample(4).dash_serial,1,"I01 held press no edge")
	event.echo = true; router.feed(event)
	t.equal(router.sample(5).dash_serial,1,"I01 echo no edge")
	router.set_enabled(false)
	t.equal(router.sample(6).axis(),Vector2.ZERO,"I01 focus loss neutral")
	t.equal(router.sample(6).dash_serial,1,"I01 clear preserves serial")
	router.set_enabled(true)
	t.equal(router.sample(7).axis(),Vector2.ZERO,"I01 regain requires new input")
	event.echo = false; event.pressed = false; router.feed(event)
	event.pressed = true; router.feed(event)
	t.equal(router.sample(8).dash_serial,2,"I01 new press after release")
	router.clear()
	var motion: InputEventJoypadMotion = InputEventJoypadMotion.new()
	motion.axis = JOY_AXIS_LEFT_X; motion.axis_value = 0.19; router.feed(motion)
	t.equal(router.sample(9).axis(),Vector2.ZERO,"I01 stick deadzone")
	motion.axis_value = 1; router.feed(motion)
	t.equal(router.sample(10).axis(),Vector2.RIGHT,"I01 stick full")
	var command: InputCommand = router.sample(10)
	var copied: InputCommand = command.copy(); copied.axis_x = 0
	t.equal(command.axis_x,127,"I01 command copy independent")
	command.axis_x = 127; command.axis_y = 127
	t.near(command.axis().length(),1,0.00001,"I01 diagonal command normalized")
	event.pressed = false; router.feed(event)
	event.pressed = true; router.feed(event)
	var published: int = command.dash_serial
	router.set_enabled(false)
	t.equal(router.sample(11).dash_serial,published,"I01 focus loss discards unsampled edge")
	set_meta("completed",true)
