extends RefCounted
func run(t: TestAssert) -> void:
	var catalog: LevelCatalog = LevelCatalog.current()
	t.equal(catalog.count(),9,"P9 ordered catalog has nine unique stable IDs")
	var root: String = "user://progress_test_%d" % Time.get_ticks_usec(); DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(root))
	var store: ProgressStore = ProgressStore.new(catalog); store.path = root+"/progress.json"; store.load_progress()
	t.is_true(store.unlocked(catalog.first_id()),"P9 first unlocked")
	t.is_true(not store.unlocked(&"garden"),"P9 later locked")
	t.fails(store.reset_progress(false),"P9 reset requires confirmation")
	t.is_true(store.accept_completion(&"dock",0,4000,2400).ok,"P9 atomic first completion")
	t.is_true(store.unlocked(&"garden") and store.continue_id()==&"garden","P9 unlock next and continue")
	store.accept_completion(&"dock",0,3000,1800); store.accept_completion(&"dock",1,5000,3000)
	t.equal(store.best(&"dock",0),{"best_score":4000,"best_time_ticks":1800},"P9 score and time independent best")
	t.equal(store.best(&"dock",1),{"best_score":5000,"best_time_ticks":3000},"P9 difficulty records separate")
	var restarted: ProgressStore = ProgressStore.new(catalog); restarted.path = store.path; restarted.load_progress()
	t.is_true(restarted.completed(&"dock"),"P9 restart restores stable completion")
	var copy: String = FileAccess.get_file_as_string(store.path+".bak")
	var corrupt: FileAccess = FileAccess.open(store.path,FileAccess.WRITE); corrupt.store_string("broken"); corrupt.close()
	restarted.load_progress()
	t.is_true(restarted.completed(&"dock") and not restarted.warning.is_empty(),"P9 corrupt primary recovers backup")
	t.equal(FileAccess.get_file_as_string(store.path+".bak"),copy,"P9 recovery never corrupts valid backup")
	t.is_true(restarted.save().ok,"P9 recovered data saves again")
	var reordered: LevelCatalog = LevelCatalog.new(); reordered.entries = catalog.entries.duplicate(true); reordered.entries.reverse()
	var moved: ProgressStore = ProgressStore.new(reordered); moved.path = store.path; moved.load_progress()
	t.is_true(moved.completed(&"dock") and moved.best(&"dock",0).best_score==4000,"P9 reordered catalog retains ID records")
	t.equal(moved.continue_id(),StringName(reordered.entries[0].id),"P9 continue follows new order")
	# A guest can store a host-unlocked level, without inventing earlier completions.
	store.accept_completion(&"aux_core",0,5000,2000)
	t.is_true(store.completed(&"aux_core") and store.unlocked(&"station_heart"),"P9 guest completion unlocks successor")
	t.is_true(not store.completed(&"garden"),"P9 guest never fabricates earlier history")
	var blocked: ProgressStore = ProgressStore.new(catalog); blocked.path = root+"/missing/progress.json"
	t.fails(blocked.accept_completion(&"dock",0,1,1),"P9 disk failure reported")
	t.is_true(blocked.completed(&"dock") and blocked.dirty and not blocked.warning.is_empty(),"P9 disk failure preserves memory")
	t.is_true(store.reset_progress(true).ok,"P9 confirmed reset")
	store.load_progress(); t.is_true(not store.completed(&"dock") and store.continue_id()==&"dock","P9 reset survives restart")
	var backup: FileAccess = FileAccess.open(store.path,FileAccess.WRITE); backup.store_string("broken"); backup.close(); store.load_progress()
	t.is_true(not store.completed(&"dock"),"P9 reset clears recoverable backup too")
	var future: Dictionary = store.defaults(); future.schema_version = 99
	var f: FileAccess = FileAccess.open(store.path,FileAccess.WRITE); f.store_string(JSON.stringify(future)); f.close(); var before: String = FileAccess.get_file_as_string(store.path)
	store.load_progress(); t.fails(store.accept_completion(&"dock",0,1,1),"P9 future version is not overwritten")
	t.equal(FileAccess.get_file_as_string(store.path),before,"P9 unknown version preserved byte for byte")
	var bad: Dictionary = store.defaults(); bad.completed = ["dock","dock"]; t.fails(store.validate(bad),"P9 duplicate IDs rejected")
	bad = store.defaults(); bad.records = {"dock":{"normal":{"best_score":NAN,"best_time_ticks":1}}}; t.fails(store.validate(bad),"P9 nonfinite record rejected")
	set_meta("completed",true)
